package io.github.belgif.rest.guide.validator.rules.oas;

import org.eclipse.microprofile.openapi.models.OpenAPI;
import io.github.belgif.rest.guide.validator.core.ApiFunctions;
import io.github.belgif.rest.guide.validator.core.ViolationReport;
import io.github.belgif.rest.guide.validator.core.model.SchemaDefinition
import io.github.belgif.rest.guide.validator.core.ViolationLevel
import org.eclipse.microprofile.openapi.models.media.Schema;
import java.util.function.Predicate;
global io.github.belgif.rest.guide.validator.core.ViolationReport oas;
import io.github.belgif.rest.guide.validator.core.parser.Parser.ParserResult;
global io.github.belgif.rest.guide.validator.core.parser.Parser.ParserResult parserResult;

function void violationPropertiesCamelCase(ViolationReport oas, String propertyName, SchemaDefinition schema){
    oas.addViolation("[jsn-naming]",
           		 "All JSON property names SHOULD be written in lowerCamelCase notation.",
           		    "[propertyName: " + propertyName + "]",
           		  schema, ViolationLevel.RECOMMENDED);
}

function boolean isExceptionallyAllowedWithinCloudEvents(SchemaDefinition schemaDefinition, String nonLowerCamelCasePropertyName, ParserResult parserResult) {
    if (!"data_base64".equals(nonLowerCamelCasePropertyName)) {
        return false;
    }
    Predicate<SchemaDefinition> matchesBase = candidate -> "AsynchronousMessage".equals(candidate.getIdentifier());
    SchemaDefinition context = schemaDefinition;
    while (true) {
        SchemaDefinition candidate = context;
        while (true) {
            if (matchesBase.test(candidate)) {
                return true;
            }
            if (candidate.getModel().getRef() == null) {
                break;
            }
            candidate = (SchemaDefinition) parserResult.resolve(candidate.getModel());
        }
        if (candidate.getModel().getAllOf() != null && candidate.getModel().getAllOf().stream().anyMatch(member -> ApiFunctions.schemaMeetsCondition(member, parserResult, matchesBase))) {
            return true;
        }
        if (context.isHighLevelSchema()) {
            return false;
        }
        context = (SchemaDefinition) context.getParent();
    }
}

rule "Properties CamelCase"
	when
        $schema: SchemaDefinition(!isNestedInNot(), $propertyName: /model/properties/keySet#String, !ApiFunctions.isLowerCamelCase($propertyName))
        SchemaDefinition(!isExceptionallyAllowedWithinCloudEvents(this, $propertyName, parserResult)) from $schema
    then
        violationPropertiesCamelCase(oas, $propertyName, $schema);
end
